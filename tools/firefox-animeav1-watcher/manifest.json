{
  "manifest_version": 2,
  "name": "AnimeAV1 Watcher - BotAnime",
  "version": "1.1.0",
  "description": "Marca solo los capítulos que ves en streaming en animeav1.com y Netflix como vistos en el bot de Discord.",
  "permissions": [
    "storage",
    "https://animeav1.com/*",
    "https://player.zilla-networks.com/*",
    "https://animeav1.uns.bio/*",
    "https://voe.sx/*",
    "https://byselapuix.com/*",
    "https://www.mp4upload.com/*",
    "https://www.netflix.com/*",
    "https://newjg.chickenkiller.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://animeav1.com/media/*"],
      "js": ["content-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://player.zilla-networks.com/*",
        "https://animeav1.uns.bio/*",
        "https://voe.sx/*",
        "https://byselapuix.com/*",
        "https://www.mp4upload.com/*"
      ],
      "all_frames": true,
      "js": ["content-player.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content-netflix.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "AnimeAV1 Watcher"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "animeav1-watcher@botanime.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
